<div class="header-icons">
    <button
        class="header__button"
        href
        aria-label="Search Page"
        type="button"
        onclick="overlayMenu.showModal()"
    >
        <svg
            width="21"
            height="20"
            viewBox="0 0 21 20"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >
            <path
                d="M17.6329 17.5L14.0137 13.8809M14.0137 13.8809C14.6328 13.2618 15.1238 12.5269 15.4589 11.718C15.7939 10.9091 15.9664 10.0422 15.9664 9.16672C15.9664 8.29121 15.7939 7.42429 15.4589 6.61543C15.1238 5.80657 14.6328 5.07162 14.0137 4.45255C13.3946 3.83348 12.6597 3.3424 11.8508 3.00736C11.042 2.67232 10.175 2.49988 9.29953 2.49988C8.42403 2.49988 7.5571 2.67232 6.74824 3.00736C5.93938 3.3424 5.20444 3.83348 4.58536 4.45255C3.33509 5.70282 2.63269 7.39856 2.63269 9.16672C2.63269 10.9349 3.33509 12.6306 4.58536 13.8809C5.83564 15.1312 7.53137 15.8336 9.29953 15.8336C11.0677 15.8336 12.7634 15.1312 14.0137 13.8809Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
            />
        </svg>
    </button>
    <dialog id="overlayMenu">
        <form class="model" method="dialog">
            <div class="search-header">
                <p class="search-header_title">Search</p>
                <button class="search-header_close">
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M6 6L18 18"
                            stroke="black"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                        <path
                            d="M6 18L18 6"
                            stroke="black"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        />
                    </svg>
                </button>
            </div>
            <div class="search">
                <button class="search-icons"></button>
                <div class="input">
                    <input type="text" placeholder="Serch" />
                </div>
            </div>
            <div class="search-footer_button">
                <button class="footer_button-cansel">Cancel</button>
            </div>
        </form>
    </dialog>
    <%- include('messages-button') %>
    <%- include('notification-button') %>
    <%- include('settings-button') %>
</div>
